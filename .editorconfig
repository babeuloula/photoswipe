# Style de code partagé par l'IDE et ktlint (PS-5).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120
# Les fonctions @Composable s'écrivent en PascalCase (convention Compose).
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
