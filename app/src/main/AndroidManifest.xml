<?xml version="1.0" encoding="utf-8"?>
<!-- INTERNET est interdite (SPEC §0.6). -->
<!-- Application en portrait uniquement (décision de Jérémy, PS-32). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lecture des photos et vidéos de la galerie (Android 13+, SPEC §4.1). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Accès partiel d'Android 14+ : l'utilisateur ne partage qu'une sélection (SPEC §4.1). -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Rappel quotidien : demandée seulement quand l'utilisateur l'active (SPEC §3.6). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PhotoSwipeApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoSwipe">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
