<?xml version="1.0" encoding="utf-8"?>
<!-- INTERNET est interdite (SPEC §0.6). -->
<!-- Application en portrait uniquement (décision de Jérémy, PS-32). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lecture des photos et vidéos de la galerie (Android 13+, SPEC §4.1). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Accès partiel d'Android 14+ : l'utilisateur ne partage qu'une sélection (SPEC §4.1). -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Rappel quotidien : demandée seulement quand l'utilisateur l'active (SPEC §3.6). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Accès « Gestion des médias », donné par l'utilisateur dans les réglages d'Android : la
         corbeille et les favoris s'appliquent sans dialogue système (SPEC §3.5, ADR 0023). -->
    <uses-permission
        android:name="android.permission.MANAGE_MEDIA"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".PhotoSwipeApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoSwipe">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Replanifie le rappel quotidien après un changement d'heure ou de fuseau (SPEC §3.6). -->
        <receiver
            android:name=".reminder.ReminderRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager est configuré par PhotoSwipeApplication (fabrique Hilt des tâches) : son initialisation automatique est retirée. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
