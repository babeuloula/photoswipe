<?xml version="1.0" encoding="utf-8"?>
<!-- INTERNET est interdite (SPEC §0.6). -->
<!-- Application en portrait uniquement (décision de Jérémy, PS-32). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lecture des photos et vidéos de la galerie (Android 13+, SPEC §4.1). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Accès partiel d'Android 14+ : l'utilisateur ne partage qu'une sélection (SPEC §4.1). -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Rappel quotidien : demandée seulement quand l'utilisateur l'active (SPEC §3.6). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Rappel à l'heure pile : alarmes exactes, autorisées par l'utilisateur dans « Alarmes et
         rappels » (Android 14+) ; sans elles, WorkManager et une heure approximative (PS-125, ADR 0031). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Les alarmes ne survivent pas à un redémarrage : le rappel est replanifié au démarrage. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Accès « Gestion des médias », donné par l'utilisateur dans les réglages d'Android : la
         corbeille et les favoris s'appliquent sans dialogue système (SPEC §3.5, ADR 0023). -->
    <uses-permission
        android:name="android.permission.MANAGE_MEDIA"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".PhotoSwipeApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoSwipe">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Liens profonds photoswipe://today, summary, day/AAAA-MM-JJ (PS-171, ADR 0038) : ils
                 ouvrent seulement un écran, sans rien modifier ni renvoyer. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="photoswipe" />
            </intent-filter>
            <!-- Raccourcis de l'appui long sur l'icône : « Trier aujourd'hui » et « Résumé ». -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Tuile « PhotoSwipe » des réglages rapides (PS-172, ADR 0038) : ouvre la pile du jour,
             sans compteur. -->
        <service
            android:name=".tile.SortTodayTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Reprogrammation du rappel d'aujourd'hui, ouverte par l'action de la notification : un
             sélecteur d'heure par-dessus l'écran, hors de la tâche de l'application (SPEC §3.6). -->
        <activity
            android:name=".reminder.SnoozeReminderActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/Theme.PhotoSwipe.Translucent"
            tools:ignore="LockedOrientationActivity" />

        <!-- Replanifie le rappel quotidien après un changement d'heure ou de fuseau, un redémarrage,
             ou un changement de l'autorisation des alarmes exactes (SPEC §3.6, PS-125). -->
        <!-- Application choisie dans la feuille de partage, pour « Renvoyer avec … » (PS-163). -->
        <receiver
            android:name=".share.ShareTargetReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.ReminderRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Alarmes exactes du rappel (PS-125), reçues de l'AlarmManager. -->
        <receiver
            android:name="fr.babeuloula.photoswipe.data.reminder.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Widget « Ce jour-là » de l'écran d'accueil (PS-170) et son réglage « montrer une photo »,
             ouvert à la pose du widget puis par « Réglages du widget ». -->
        <receiver
            android:name=".widget.ThisDayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/this_day_widget_info" />
        </receiver>

        <activity
            android:name=".widget.ThisDayWidgetConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/widget_settings_title"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- WorkManager est configuré par PhotoSwipeApplication (fabrique Hilt des tâches) : son initialisation automatique est retirée. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
