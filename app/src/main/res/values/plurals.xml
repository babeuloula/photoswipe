<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Exemple de pluriel (SPEC §9) : jamais de concaténation, toujours getQuantityString.
        Utilisé par le résumé de session (epic 7) ; d'ici là, seul LocalizationTest le lit.
    -->
    <plurals name="media_count" tools:ignore="UnusedResources">
        <item quantity="one">%d media item</item>
        <item quantity="other">%d media items</item>
    </plurals>
    <!-- Nombre de médias à trier pour un jour de l'accueil (SPEC §4.2). -->
    <plurals name="home_remaining">
        <item quantity="one">%d item to sort</item>
        <item quantity="other">%d items to sort</item>
    </plurals>
    <!-- Bannière des suppressions en attente sur l'accueil (SPEC §3.4). -->
    <plurals name="home_pending_deletions">
        <item quantity="one">%d item waiting to be deleted</item>
        <item quantity="other">%d items waiting to be deleted</item>
    </plurals>
    <!-- Ancienneté d'un souvenir sur sa carte, « 3 years ago » (SPEC §4.3). -->
    <plurals name="deck_years_ago">
        <item quantity="one">%d year ago</item>
        <item quantity="other">%d years ago</item>
    </plurals>
    <!-- Détail du résumé (SPEC §3.5). -->
    <plurals name="summary_kept">
        <item quantity="one">%d item kept</item>
        <item quantity="other">%d items kept</item>
    </plurals>
    <plurals name="summary_marked">
        <item quantity="one">%d item marked for deletion</item>
        <item quantity="other">%d items marked for deletion</item>
    </plurals>
    <plurals name="summary_trashed">
        <item quantity="one">%d item moved to the trash. You can restore it from your gallery\'s trash for about 30 days.</item>
        <item quantity="other">%d items moved to the trash. You can restore them from your gallery\'s trash for about 30 days.</item>
    </plurals>
    <plurals name="summary_still_marked">
        <item quantity="one">%d item stays marked for deletion.</item>
        <item quantity="other">%d items stay marked for deletion.</item>
    </plurals>
    <plurals name="reminder_title">
        <item quantity="one">%d memory to sort today</item>
        <item quantity="other">%d memories to sort today</item>
    </plurals>
    <plurals name="summary_trash_confirm_title">
        <item quantity="one">Move %d item to the trash?</item>
        <item quantity="other">Move %d items to the trash?</item>
    </plurals>
    <plurals name="summary_favorites">
        <item quantity="one">%d favorite</item>
        <item quantity="other">%d favorites</item>
    </plurals>
    <!-- Sous l'espace libéré du résumé : il dépend de la confirmation (ADR 0025). -->
    <plurals name="summary_if_confirmed">
        <item quantity="one">If you confirm the %d marked item</item>
        <item quantity="other">If you confirm the %d marked items</item>
    </plurals>
    <!-- Poids d'un fichier de moins d'un kilo-octet (SPEC §3.5, §4.3). -->
    <plurals name="file_size_bytes">
        <item quantity="one">%d byte</item>
        <item quantity="other">%d bytes</item>
    </plurals>
    <plurals name="settings_statistics_deleted_count">
        <item quantity="one">%d photo or video</item>
        <item quantity="other">%d photos and videos</item>
    </plurals>
    <!-- Sous l'espace libéré aujourd'hui (ADR 0034). -->
    <plurals name="summary_trashed_today_detail">
        <item quantity="one">%d item moved to the trash today</item>
        <item quantity="other">%d items moved to the trash today</item>
    </plurals>
    <!-- Ligne « Trié aujourd'hui » du résumé : suppressions confirmées et leur poids (ADR 0034). -->
    <plurals name="summary_deleted_today">
        <item quantity="one">%1$d item deleted (%2$s)</item>
        <item quantity="other">%1$d items deleted (%2$s)</item>
    </plurals>
    <!-- Accueil : ce qui a été supprimé ce jour-là, même s'il n'en reste rien (ADR 0034). -->
    <plurals name="home_day_deleted">
        <item quantity="one">%1$d item deleted · %2$s freed</item>
        <item quantity="other">%1$d items deleted · %2$s freed</item>
    </plurals>
    <!-- Vue d'ensemble d'un jour (PS-139). -->
    <plurals name="day_overview_memories">
        <item quantity="one">%d memory</item>
        <item quantity="other">%d memories</item>
    </plurals>
    <plurals name="day_overview_sort">
        <item quantity="one">Sort the last one</item>
        <item quantity="other">Sort the %d left</item>
    </plurals>
</resources>
