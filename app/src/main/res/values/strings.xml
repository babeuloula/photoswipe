    <!-- Écran d'explication avant la demande d'accès aux médias (SPEC §4.1). -->
    <string name="permission_rationale_title">Relive your memories</string>
    <string name="permission_rationale_what">Every day, PhotoSwipe shows you the photos and videos you took on the same day in previous years, so you can keep the ones you love and clear out the rest.</string>
    <string name="permission_rationale_why_title">Why access to your photos</string>
    <string name="permission_rationale_why">To find what you took on this date and estimate the space you can free.</string>
    <string name="permission_rationale_private_title">Nothing leaves your phone</string>
    <string name="permission_rationale_private">No internet connection, no account: everything stays on the device, and nothing is deleted without your confirmation.</string>
    <string name="permission_rationale_next">Android will then ask for permission</string>
    <string name="permission_rationale_continue">Continue</string>
