<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Ambre de la notification du rappel (setColor) : le primary de la palette de repli
        « planche-contact » (ui/theme/Color.kt, ADR 0025), qu'Android ne peut pas lire dans Compose.
    -->
    <color name="notification_accent">#FF785A0B</color>
    <!-- Fond de l'icône adaptative et de l'icône de l'écran de démarrage : le primary de repli. -->
    <color name="launcher_background">#FF785A0B</color>
    <!-- Fond de l'écran de démarrage : la surface du thème clair de repli. -->
    <color name="splash_background">#FFFFF8F2</color>
    <!-- Aperçu du widget « Ce jour-là » (PS-170) : primaryContainer et onPrimaryContainer du thème. -->
    <color name="widget_container">#FFFFDF9F</color>
    <color name="widget_on_container">#FF5C4300</color>
</resources>
