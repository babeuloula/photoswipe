<?xml version="1.0" encoding="utf-8"?>
<!--
    Langues proposées dans le réglage de langue par application d'Android 13+ (SPEC §9).
    L'anglais (values/) est la langue par défaut. Toute nouvelle traduction values-xx s'ajoute ici :
    LocalizationTest le vérifie.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="fr" />
</locale-config>
