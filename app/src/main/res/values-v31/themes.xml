<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Écran de démarrage d'Android 12+ (ADR 0025) : fond de la surface du thème, l'icône sur un
        rond ambre, sans animation ; Android le retire en fondu vers l'accueil. Avant Android 12, ces
        attributs n'existent pas : le thème de values/ s'applique seul (PS-181).
    -->
    <style name="Theme.PhotoSwipe" parent="Base.Theme.PhotoSwipe">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launcher_background</item>
    </style>
</resources>
