<?xml version="1.0" encoding="utf-8"?>
<!-- Application de test de :data : lit la galerie et peut recevoir l'accès « Gestion des médias » (PS-84). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 10 : lecture et suppression directe des photos du shell, comme l'app (PS-186, ADR 0042). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_MEDIA"
        tools:ignore="ProtectedPermissions" />

    <application android:requestLegacyExternalStorage="true">
        <!-- Activité vide au premier plan : les demandes système se lancent depuis elle, comme dans l'app. -->
        <activity
            android:name="android.app.Activity"
            android:exported="false" />
    </application>
</manifest>
